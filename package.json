{
  "name": "npm-import-gate",
  "version": "0.1.0",
  "description": "Pre-merge CI gate that detects import-time and runtime dependency compromise in npm projects, for the world after npm v12 install-script blocking",
  "type": "module",
  "license": "MIT",
  "author": "Md Nur Islam",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "import-gate": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "gate": "node src/cli.js scan",
    "rules": "node src/cli.js rules",
    "verify:detection": "node evaluation/verify-detection.mjs",
    "verify:sandbox": "node evaluation/verify-sandbox.mjs",
    "evaluate": "node evaluation/run-evaluation.mjs"
  },
  "keywords": [
    "supply-chain",
    "npm",
    "security",
    "ci",
    "malicious-packages"
  ],
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
